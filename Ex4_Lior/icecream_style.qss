QWidget {
    background-color: #f7fafc;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #2d3748;
}

QLabel#headerTitle {
    font-size: 20px;
    font-weight: bold;
    color: #2c5282;
    padding: 8px 0;
}

QPushButton {
    background-color: #3182ce;
    color: #ffffff;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #2b6cb0;
}

QPushButton:pressed {
    background-color: #2c5282;
}

QPushButton#aboutButton {
    background-color: #718096;
}

QPushButton#aboutButton:hover {
    background-color: #4a5568;
}
